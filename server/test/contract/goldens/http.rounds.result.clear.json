{
  "name": "http.rounds.result.clear",
  "route": "PATCH /match/{matchId}/rounds/result",
  "why": "OMITTING winner is what actually clears a previously declared result: the round falls back to its score-derived method (here a 0-0 tie). This is the shape the Kotlin client really sends for \"no winner\".",
  "request": {
    "method": "PATCH",
    "path": "/match/<match:toClearResult>/rounds/result",
    "as": "creator",
    "body": {
      "stoppage": false
    }
  },
  "response": {
    "status": 200,
    "content_type": "application/json; charset=utf-8",
    "body": {
      "data": {
        "match": {
          "blue_competitor": {
            "id": "<user:blue>",
            "name": "Blair Blue"
          },
          "break_duration": 60,
          "break_remaining": 55,
          "break_started_at": "2026-01-01T12:09:55.000Z",
          "creator_id": "<user:creator>",
          "ended_at": null,
          "id": "<match:toClearResult>",
          "mat": {
            "creator_id": "<user:creator>",
            "id": "<mat:flow>",
            "judge_count": 2,
            "name": "Flow Mat"
          },
          "mat_id": "<mat:flow>",
          "red_competitor": {
            "id": "<user:red>",
            "name": "Rory Red"
          },
          "rounds": [
            {
              "ended_at": "2026-01-01T12:09:55.000Z",
              "id": "<round:toClearResult>",
              "max_duration": 180,
              "paused": false,
              "result": {
                "method": {
                  "type": "tie",
                  "value": "0"
                },
                "winner": null
              },
              "score": {
                "<user:blue>": 0,
                "<user:red>": 0
              },
              "started_at": "2026-01-01T12:09:15.000Z",
              "time_remaining": null
            }
          ],
          "started_at": "2026-01-01T12:09:15.000Z",
          "winner": null
        }
      },
      "status": "ok"
    }
  }
}
