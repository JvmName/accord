{
  "name": "http.rounds.end.success",
  "route": "POST /match/{matchId}/rounds/end",
  "why": "Step 1 of the two-step end-round flow: stops the clock and starts the break. The response already carries break_started_at, break_duration and break_remaining.",
  "request": {
    "method": "POST",
    "path": "/match/<match:toEndRound>/rounds/end",
    "as": "creator",
    "body": null
  },
  "response": {
    "status": 200,
    "content_type": "application/json; charset=utf-8",
    "body": {
      "data": {
        "match": {
          "blue_competitor": {
            "id": "<user:blue>",
            "name": "Blair Blue"
          },
          "break_duration": 60,
          "break_remaining": 60,
          "break_started_at": "2026-01-01T12:10:00.000Z",
          "creator_id": "<user:creator>",
          "ended_at": null,
          "id": "<match:toEndRound>",
          "mat": {
            "creator_id": "<user:creator>",
            "id": "<mat:flow>",
            "judge_count": 2,
            "name": "Flow Mat"
          },
          "mat_id": "<mat:flow>",
          "red_competitor": {
            "id": "<user:red>",
            "name": "Rory Red"
          },
          "rounds": [
            {
              "ended_at": "2026-01-01T12:10:00.000Z",
              "id": "<round:toEndRound>",
              "max_duration": 180,
              "paused": false,
              "result": {
                "method": {
                  "type": "tie",
                  "value": "0"
                },
                "winner": null
              },
              "score": {
                "<user:blue>": 0,
                "<user:red>": 0
              },
              "started_at": "2026-01-01T12:09:00.000Z",
              "time_remaining": null
            }
          ],
          "started_at": "2026-01-01T12:09:00.000Z",
          "winner": null
        }
      },
      "status": "ok"
    }
  }
}
