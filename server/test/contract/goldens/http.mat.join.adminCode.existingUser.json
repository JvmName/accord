{
  "name": "http.mat.join.adminCode.existingUser",
  "route": "POST /mat/{matCode}/join",
  "why": "Joining with an admin code adds the caller to the mat judges.",
  "request": {
    "method": "POST",
    "path": "/mat/<code:join-admin>/join",
    "as": "joiner",
    "body": null
  },
  "response": {
    "status": 200,
    "content_type": "application/json; charset=utf-8",
    "body": {
      "data": {
        "api_token": "<token:joiner>",
        "mat": {
          "creator_id": "<user:creator>",
          "id": "<mat:join>",
          "judge_count": 2,
          "judges": [
            {
              "id": "<user:judgeA>",
              "name": "Jordan Judge"
            },
            {
              "id": "<user:joiner>",
              "name": "Jo Joiner"
            }
          ],
          "name": "Join Mat"
        },
        "user": {
          "id": "<user:joiner>",
          "name": "Jo Joiner"
        }
      },
      "status": "ok"
    }
  }
}
