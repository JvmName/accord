{
    "name": "server",
    "version": "1.0.0-rc08",
    "private": true,
    "scripts": {
        "start": "nodemon ./bin/www",
        "worker": "nodemon ./bin/worker",
        "test": "bun test --isolate",
        "typecheck": "tsc --noEmit",
        "generate:openapi": "bun run bin/generate-openapi.ts",
        "db:create_migration": "./bin/migrate create_migration",
        "db:migrate": "./bin/migrate migrate",
        "db:rollback": "./bin/migrate rollback",
        "drizzle:generate": "bunx --bun drizzle-kit generate",
        "drizzle:migrate": "bunx --bun drizzle-kit migrate",
        "drizzle:studio": "bunx --bun drizzle-kit studio"
    },
    "engines": {
        "bun": ">=1.4.0"
    },
    "dependencies": {
        "commander": "^14.0.0",
        "cors": "^2.8.5",
        "drizzle-orm": "^0.45.4",
        "express": "^5.0.0",
        "express-openapi-validator": "^5.0.0",
        "http-errors": "~1.6.3",
        "inflection": "^1.13.4",
        "pino": "^10.0.0",
        "pino-http": "^11.0.0",
        "pino-pretty": "^13.0.0",
        "response-time": "^2.0.0",
        "sequelize": "^6.0.0",
        "sequelize-cli": "^6.0.0",
        "socket.io": "^4.0.0",
        "sqlite3": "^5.0.0",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@asteasolutions/zod-to-openapi": "^9.1.0",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/node": "^26.5.1",
        "@types/response-time": "^2.3.9",
        "ajv": "^8.20.0",
        "bun-types": "^1.4.2",
        "drizzle-kit": "^0.31.11",
        "nodemon": "^3.1.11",
        "socket.io-client": "^4.0.0",
        "typescript": "5.9.3"
    }
}
