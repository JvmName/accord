{
  // NOTE: tsc is a TYPECHECK GATE, NOT A BUILD STEP.
  // bun is the runtime and strips types natively at execution time — there is
  // no compilation/emit step in this project. `tsc --noEmit` only ever
  // verifies types; it never produces the files that run. Do not add an
  // `emit`/`build`/`tsc` step to any script that ships code — that is bun's
  // job, not tsc's. (server-ts task 03)
  "compilerOptions": {
    "target": "ES2022",
    // CommonJS is deliberate — do NOT "modernize" to ESM; the server and its
    // tests rely on synchronous `require` (lazy loading, `mock.module`).
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "types": ["node", "bun-types"],

    "noEmit": true,        // bun strips types; tsc is a gate, not a build
    "allowJs": false,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["src/**/*.ts", "lib/**/*.ts", "bin/**/*.ts", "drizzle.config.ts"],
  "exclude": ["node_modules", "coverage", "public"]
}
