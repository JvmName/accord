# Copied to /srv/accord/.env by the Ansible playbook, from the variables in ansible/vars.yml.
WEB_HOST=rdk.jvmname.dev
API_HOST=rdk.api.jvmname.dev
ACME_EMAIL=you@example.com

# Set by the deploy workflow on every deploy.
API_TAG=latest

# Optional: a dead-man's-switch URL (healthchecks.io or similar) the worker requests once a minute.
HEARTBEAT_URL=
